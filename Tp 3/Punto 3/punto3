<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ejercicio 3 - Tabla de datos</title>
</head>
<body>
    <main>
        <h1>Horario Semanal de Clases</h1>
        
        <!-- Agregamos border="1" solo para que la tabla sea visible antes de usar CSS en el Ejercicio 5 -->
        <table border="1">
            <thead>
                <tr>
                    <th>Hora</th>
                    <th>Lunes</th>
                    <th>Martes</th>
                    <th>Miércoles</th>
                    <th>Jueves</th>
                    <th>Viernes</th>
                </tr>
            </thead>
            
            <tbody>
                <tr>
                    <td>08:00 - 10:00</td>
                    <td>Ingeniería de Software</td>
                    <td>Matemática Discreta</td>
                    <td>Álgebra Lineal</td>
                    <td>Programación Orientada a Objetos</td>
                    <td>Ingeniería de Software</td>
                </tr>
                <tr>
                    <td>10:00 - 10:30</td>
                    <!-- Uso de colspan para combinar 5 columnas en el recreo -->
                    <td colspan="5" style="text-align: center;"><strong>Recreo / Descanso</strong></td>
                </tr>
                <tr>
                    <td>10:30 - 12:30</td>
                    <td>Álgebra Lineal</td>
                    <td>Programación Orientada a Objetos</td>
                    <!-- Uso de rowspan para una clase de laboratorio que dura dos módulos de tiempo -->
                    <td rowspan="2">Práctica de Laboratorio (Python/Node.js)</td>
                    <td>Matemática Discreta</td>
                    <td>Arquitectura de Software</td>
                </tr>
                <tr>
                    <td>12:30 - 14:00</td>
                    <td>Estudio Libre</td>
                    <td>Estudio Libre</td>
                    <!-- El miércoles no tiene <td> aquí porque el rowspan de arriba ocupa este espacio -->
                    <td>Estudio Libre</td>
                    <td>Estudio Libre</td>
                </tr>
            </tbody>
            
            <tfoot>
                <tr>
                    <!-- Uso de colspan en el pie de la tabla -->
                    <td colspan="6">Horario correspondiente a la Licenciatura en Sistemas de Información - FCyT Sede Concepción del Uruguay</td>
                </tr>
            </tfoot>
        </table>
    </main>
</body>
</html>